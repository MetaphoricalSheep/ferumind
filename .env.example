# Ferumind runtime configuration
# Copy to .env and adjust for local development.
# Do not commit .env files.

# Override workspace root path (default: ./workspace)
# FERUMIND_WORKSPACE=/home/user/ferumind-workspace

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
# Applied once at CLI/MCP startup; logs go to stderr, never stdout (stdout
# carries the MCP JSON-RPC stream). An invalid value fails before any command
# runs. httpx and the MCP SDK stay pinned even at DEBUG so signed download
# URLs and tool arguments are never logged.
# FERUMIND_LOG_LEVEL=INFO

# ── Image storage policy ───────────────────────────────────────────────────
# Uploaded JPEG/PNG/WebP files are downscaled and re-encoded before they are
# written, so the workspace never accumulates camera-sized originals. Change
# these and re-run `ferumind compress-images` to retune the whole workspace.
# Lossless sources (PNG, lossless WebP) stay lossless; nothing is ever made
# larger, and the pass is idempotent.

# Set to false to store uploads byte-for-byte as received (default: true)
# FERUMIND_IMAGE_COMPRESSION=true

# Longest edge in pixels for a stored image, 512-8192 (default: 2560)
# FERUMIND_IMAGE_MAX_EDGE=2560

# JPEG/lossy-WebP encode quality, 60-100 (default: 85)
# FERUMIND_IMAGE_JPEG_QUALITY=85

# Largest response body the caller's transport will carry, in megabytes
# (default: 10, the OpenAI tunnel control-plane limit). resources/read
# refuses an original whose base64 form would exceed this, pointing the
# caller at read_file instead. Blob payloads inflate by 4/3, so the usable
# original size is three quarters of this value. Fractions are allowed
# (0.5 is half a megabyte); 1 MB here means 1024x1024 bytes.
# FERUMIND_MAX_RESOURCE_MB=10

CONTROL_PLANE_TUNNEL_ID=tunnel_xxx
CONTROL_PLANE_API_KEY=sk-proj-xxx
FERUMIND_TUNNEL_PROFILE=ferumind
FERUMIND_WORKSPACE=workspace
TUNNEL_CLIENT_BIN=tunnel-client
