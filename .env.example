# Lattice runtime configuration
# Copy to .env and adjust for local development.
# Do not commit .env files.

# Override workspace root path (default: ./workspace)
# LATTICE_WORKSPACE=/home/user/lattice-workspace

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LATTICE_LOG_LEVEL=INFO

# ── Image storage policy ───────────────────────────────────────────────────
# Uploaded JPEG/PNG/WebP files are downscaled and re-encoded before they are
# written, so the workspace never accumulates camera-sized originals. Change
# these and re-run `lattice compress-images` to retune the whole workspace.
# Lossless sources (PNG, lossless WebP) stay lossless; nothing is ever made
# larger, and the pass is idempotent.

# Set to false to store uploads byte-for-byte as received (default: true)
# LATTICE_IMAGE_COMPRESSION=true

# Longest edge in pixels for a stored image, 512-8192 (default: 2560)
# LATTICE_IMAGE_MAX_EDGE=2560

# JPEG/lossy-WebP encode quality, 60-100 (default: 85)
# LATTICE_IMAGE_JPEG_QUALITY=85

# Largest response body the caller's transport will carry, in bytes
# (default: 10485760 = 10 MiB, the OpenAI tunnel control-plane limit).
# resources/read refuses an original whose base64 form would exceed this,
# pointing the caller at read_file instead. Blob payloads inflate by 4/3, so
# the usable original size is three quarters of this value.
# LATTICE_MAX_RESOURCE_BYTES=10485760

CONTROL_PLANE_TUNNEL_ID=tunnel_xxx
CONTROL_PLANE_API_KEY=sk-proj-xxx
LATTICE_TUNNEL_PROFILE=lattice
LATTICE_WORKSPACE=workspace
TUNNEL_CLIENT_BIN=tunnel-client
