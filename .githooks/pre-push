#!/usr/bin/env bash
set -euo pipefail

FERUMIND_SKIP_HOOKS="${FERUMIND_SKIP_HOOKS:-0}"

if [ "$FERUMIND_SKIP_HOOKS" = "1" ]; then
  echo "⚠️  WARNING: FERUMIND_SKIP_HOOKS=1 — skipping pre-push checks" >&2
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "══════════════════════════════════════════════════"
echo "  Pre-push verification"
echo "══════════════════════════════════════════════════"

exec scripts/verify.sh
